{
  "name": "campuscare",
  "version": "1.0.0",
  "private": true,
  "description": "A Platform for Complaint Management and Redressal",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "test:api": "npm run test:api --workspace=apps/api",
    "test:cascade": "npm run test:cascade --workspace=apps/api",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pino-pretty": "^13.1.3"
  },
  "author": "Mridul Saha",
  "dependencies": {
    "nodemailer": "^10.0.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react-router-dom": "^7.18.3"
  }
}
