NODE_ENV=production
PORT=3000
DOMAIN_NAME=# Backend Domain Name
FRONTEND_DOMAIN_NAME=# Frontend Domain Name

MONGO_URI=# MongoDB URL

GOOGLE_CLIENT_ID=# Google Client ID
GOOGLE_CLIENT_SECRET=# Google Client Secret
GOOGLE_REDIRECT_URI=#{Backend Domain Name}/api/v1/auth/google

CLOUDINARY_CLOUD_NAME=# Cloudinary Cloud Name
CLOUDINARY_API_KEY=# Cloudinary API Key
CLOUDINARY_API_SECRET=# Cloudinary API Secret

JWT_SECRET=# JWT 256 Bit Secret
JWT_EXPIRY=7d
JWT_NAME=jwtToken
COOKIE_MAX_AGE=604800000
COOKIE_DOMAIN=# Domain Name

VALID_DESIGNATIONS=director,vice_chancellor,pro_vice_chancellor,dean,hod,professor,associate_professor,assistant_professor,adhoc_faculty
LEADERSHIP_DESIGNATIONS=director,vice_chancellor,pro_vice_chancellor,dean,hod
NON_STUDENT_EMAIL_DOMAINS=mitsgwalior.in
STUDENT_EMAIL_DOMAINS=mitsgwl.ac.in
ADMIN_EMAILS=# Emails of Admin for Initial Startup Seed

RUN_CRON=true
SLA_BREACH_DAYS=7

ENABLE_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=# SMTP Username (i.e Email)
SMTP_PASS=# SMTP Password
EMAIL_FROM="Campus Care <SMTP_Username>"